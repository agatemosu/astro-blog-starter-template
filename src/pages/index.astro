---
const buildDate = new Date().toLocaleString('en-US', {
  timeZone: 'Europe/Madrid',
  dateStyle: 'full',
  timeStyle: 'long'
});
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Build Info</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet">
		<style>
			:root {
				--bg-gradient: linear-gradient(135deg, #0f0c1b 0%, #1e1335 50%, #0b071e 100%);
				--card-bg: rgba(255, 255, 255, 0.03);
				--card-border: rgba(255, 255, 255, 0.08);
				--text-primary: #f3f1f6;
				--text-secondary: #a19bb0;
				--accent: #9d4edd;
				--accent-glow: rgba(157, 78, 221, 0.4);
			}

			* {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}

			body {
				font-family: 'Outfit', sans-serif;
				background: var(--bg-gradient);
				color: var(--text-primary);
				min-height: 100vh;
				display: flex;
				justify-content: center;
				align-items: center;
				overflow: hidden;
				position: relative;
			}

			/* Background decorative circles */
			.circle {
				position: absolute;
				border-radius: 50%;
				background: radial-gradient(circle, var(--accent) 0%, rgba(0,0,0,0) 70%);
				filter: blur(80px);
				opacity: 0.15;
				z-index: 1;
				pointer-events: none;
			}

			.circle-1 {
				width: 400px;
				height: 400px;
				top: -10%;
				left: -10%;
			}

			.circle-2 {
				width: 500px;
				height: 500px;
				bottom: -15%;
				right: -10%;
			}

			.container {
				position: relative;
				z-index: 2;
				text-align: center;
				padding: 2.5rem;
				border-radius: 24px;
				background: var(--card-bg);
				backdrop-filter: blur(20px);
				-webkit-backdrop-filter: blur(20px);
				border: 1px solid var(--card-border);
				box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3),
							inset 0 1px 0 rgba(255, 255, 255, 0.1);
				max-width: 500px;
				width: 90%;
				animation: fadeIn 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
			}

			h1 {
				font-size: 2rem;
				font-weight: 800;
				margin-bottom: 0.75rem;
				letter-spacing: -0.5px;
				background: linear-gradient(135deg, #ffffff 0%, #d8cde6 100%);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}

			.badge {
				display: inline-block;
				font-size: 0.75rem;
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 1.5px;
				padding: 0.35rem 0.85rem;
				border-radius: 20px;
				background: rgba(157, 78, 221, 0.1);
				color: #c8b6ff;
				border: 1px solid rgba(157, 78, 221, 0.25);
				margin-bottom: 2rem;
				box-shadow: 0 0 15px var(--accent-glow);
				animation: pulse 2s infinite ease-in-out;
			}

			.date-container {
				margin: 1.5rem 0;
			}

			.date-label {
				font-size: 0.85rem;
				color: var(--text-secondary);
				text-transform: uppercase;
				letter-spacing: 2px;
				margin-bottom: 0.5rem;
			}

			.date-value {
				font-size: 1.35rem;
				font-weight: 600;
				color: #ffffff;
				line-height: 1.4;
			}

			.divider {
				height: 1px;
				background: linear-gradient(90deg, rgba(255,255,255,0) 0%, var(--card-border) 50%, rgba(255,255,255,0) 100%);
				margin: 2rem 0;
			}

			.status {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 0.5rem;
				font-size: 0.9rem;
				color: var(--text-secondary);
			}

			.status-dot {
				width: 8px;
				height: 8px;
				background-color: #38b000;
				border-radius: 50%;
				box-shadow: 0 0 10px rgba(56, 176, 0, 0.8);
				animation: blink 1.5s infinite;
			}

			@keyframes fadeIn {
				from {
					opacity: 0;
					transform: translateY(20px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}

			@keyframes pulse {
				0%, 100% {
					box-shadow: 0 0 15px rgba(157, 78, 221, 0.3);
				}
				50% {
					box-shadow: 0 0 25px rgba(157, 78, 221, 0.6);
				}
			}

			@keyframes blink {
				0%, 100% { opacity: 0.4; }
				50% { opacity: 1; }
			}
		</style>
	</head>
	<body>
		<div class="circle circle-1"></div>
		<div class="circle circle-2"></div>
		
		<main class="container">
			<div class="badge">Production Build</div>
			<h1>Astro Deploy</h1>
			<div class="divider"></div>
			<div class="date-container">
				<div class="date-label">Build Date & Time</div>
				<div class="date-value">{buildDate}</div>
			</div>
			<div class="divider"></div>
			<div class="status">
				<div class="status-dot"></div>
				<span>System Operational</span>
			</div>
		</main>
	</body>
</html>
